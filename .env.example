BETTER_AUTH_URL=http://localhost:3000
# Generate a unique secret: node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
BETTER_AUTH_SECRET=
DATABASE_PATH=.data/pustaka.db
# Paste a Turso libsql:// URL to use it instead of the local SQLite file.
# A single private URL can include the database token: libsql://host?authToken=TOKEN
TURSO_DATABASE_URL=
# Alternatively supply the token separately for a protected database.
TURSO_AUTH_TOKEN=

# Set before running npm run admin:create. Existing accounts/passwords are never overwritten.
ADMIN_EMAIL=admin@pustaka.local
ADMIN_PASSWORD=
ADMIN_NAME=Admin Pustaka
ADMIN_USERNAME=admin_pustaka
# Optional administrative contact; local bootstrap uses a placeholder when absent.
ADMIN_PHONE=
